CREATE PROCEDURE sp_contas_vencidas
(
    @data_inicio DATE,
    @data_fim DATE,
    @parte_nome_empresa VARCHAR(100)
)
AS
BEGIN

    SET NOCOUNT ON;

    SELECT
        nome_empresa AS [Nome da empresa],
        descricao AS [Descrição],
        data_vencimento AS [Data Vencimento],

        DATEDIFF(DAY, data_vencimento, GETDATE()) 
            AS [Qtd dias vencidos]

    FROM contas_pagar

    WHERE
        pago = 0
        AND data_vencimento < GETDATE()

        AND data_vencimento BETWEEN @data_inicio AND @data_fim

        AND nome_empresa LIKE '%' + @parte_nome_empresa + '%'

    ORDER BY data_vencimento;

END;
GO

