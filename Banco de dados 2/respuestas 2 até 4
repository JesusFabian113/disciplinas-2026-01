/* =========================================================
   PASSO 4 - PROCEDURE PARA INSERIR EMPRESA
   ========================================================= */
CREATE PROCEDURE sp_inserir_empresa
(
    @nome VARCHAR(200),
    @cnpj VARCHAR(20)
)
AS
BEGIN

    -- abre a chave
    OPEN SYMMETRIC KEY ChaveCNPJ
    DECRYPTION BY CERTIFICATE CertificadoEmpresa;

    -- insere criptografado
    INSERT INTO empresa(nome, cnpj_cripto)
    VALUES
    (
        @nome,
        ENCRYPTBYKEY(KEY_GUID('ChaveCNPJ'), @cnpj)
    );

    -- fecha a chave
    CLOSE SYMMETRIC KEY ChaveCNPJ;

END;
GO

/* =========================================================
   EXEMPLO DE USO
   ========================================================= */
EXEC sp_inserir_empresa
    @nome = 'Empresa ABC',
    @cnpj = '12.345.678/0001-99';
GO

/* =========================================================
   CONSULTAR DADOS DESCRIPTOGRAFADOS
   (somente quem tiver acesso ao certificado)
   ========================================================= */

OPEN SYMMETRIC KEY ChaveCNPJ
DECRYPTION BY CERTIFICATE CertificadoEmpresa;

SELECT
    nome,
    CONVERT(VARCHAR(20), DECRYPTBYKEY(cnpj_cripto)) AS cnpj
FROM empresa;

CLOSE SYMMETRIC KEY ChaveCNPJ;
GO

